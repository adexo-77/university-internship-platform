# ==============================================================================
# Docker Environment Configuration (.env.docker.example)
# Copy this file to .env.docker:
#   PowerShell: Copy-Item .env.docker.example .env.docker
#   Bash:       cp .env.docker.example .env.docker
# ==============================================================================

# Database Credentials (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=university_platform

# Database Connection URLs for Backend (psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/university_platform
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/university_platform_test

# Environment Mode: development | production
# Local demo mode uses development (HTTP on port 8080).
# Production requires an HTTPS reverse proxy (e.g., Caddy/Nginx) terminating TLS,
# with COOKIE_SECURE=true and non-localhost CORS_ORIGINS.
ENVIRONMENT=development
PORT=8000

# CORS Allowed Origins (JSON array matching public frontend address)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Cookie Security (false for local HTTP demo; true for HTTPS production)
COOKIE_SECURE=false

# Reverse Proxy Trust (true for Docker stack behind Nginx)
TRUSTED_PROXY=true

# Host Interface Binding (127.0.0.1 for local/tunnel only; 0.0.0.0 to expose on LAN)
HOST_BIND=127.0.0.1

# Automatic Demo Seeding (demo only; set false for anything else; the seed already refuses production)
SEED_DEMO=true

# Public Demo Protection (true locks seeded demo accounts and prevents admin account provisioning)
DEMO_PUBLIC_MODE=false
