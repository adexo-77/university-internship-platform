# Environment: development | production | test
ENVIRONMENT=development
PORT=8001

# PostgreSQL Database URLs (psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/university_platform
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/university_platform_test

# CORS allowed origins (JSON string array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
