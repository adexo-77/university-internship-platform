# Environment: development | production | test
ENVIRONMENT=development
PORT=8001

# PostgreSQL Database URLs (psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/university_platform
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/university_platform_test

# CORS allowed origins (JSON string array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: Cookie security (defaults to true if ENVIRONMENT=production, false otherwise)
# COOKIE_SECURE=false

# Optional: AI Assistance (off by default; never commit real API keys)
AI_ENABLED=false
AI_PROVIDER=mock
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=400
AI_DAILY_LIMIT_PER_USER=10
AI_DAILY_LIMIT_GLOBAL=200
AI_CACHE_TTL_SECONDS=3600
